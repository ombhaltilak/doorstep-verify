# Ignore everything in root by default
/*

# Allow these root files
!.gitignore
!PROTOTYPE.md
!README.md
!render.yaml

# Allow subdirectory folders (the actual app code)
!doorstep-driver-app/
!doorstep-admin-app/
!doorstep-verify-api/

# Python
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Secrets — NEVER commit
.env
*.env

# OS
.DS_Store
Thumbs.db

# Logs
*.log
server.log

# Temp
/tmp/
*.pem
